# Copia este archivo como .env y completa los datos solo en tu laptop.
# Nunca compartas ni publiques la contraseña de correo.
EMAIL_NOTIFICATIONS_ENABLED=true

# Límite de conexiones simultáneas al proceso Node. Caddy debe atender Internet.
MAX_CONNECTIONS=500

# En producción usar rutas absolutas fuera del código, por ejemplo C:\CostaGrande\data.
# APP_DATA_DIR=
# APP_ENV_FILE=
# Cuenta SMTP segura proporcionada por cPanel.
SMTP_HOST=costagrande.com.pe
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ventas@costagrande.com.pe
SMTP_PASSWORD=
SMTP_FROM=ventas@costagrande.com.pe

# Destinatarios de las pruebas y de las cotizaciones nuevas.
EMAIL_TEST_RECIPIENT=
EMAIL_SALES_RECIPIENT=ventas@costagrande.com.pe

# Clave pública de Google Maps, restringida al dominio de la web.
GOOGLE_MAPS_API_KEY=
