# Copia este archivo como .env y completa los datos solo en tu laptop.
# Nunca compartas ni publiques la API Key.
EMAIL_NOTIFICATIONS_ENABLED=true

# Límite de conexiones simultáneas al proceso Node. Caddy debe atender Internet.
MAX_CONNECTIONS=500

# En producción usar rutas absolutas fuera del código, por ejemplo C:\CostaGrande\data.
# APP_DATA_DIR=
# APP_ENV_FILE=
RESEND_API_KEY=

# Durante la prueba inicial, usa el mismo correo con el que abriste Resend.
RESEND_TEST_RECIPIENT=

# Correo interno que recibirá las nuevas cotizaciones. Durante la prueba puede ser el mismo correo personal.
RESEND_SALES_RECIPIENT=

# Remitente temporal de Resend. Se reemplazará al verificar el dominio empresarial.
RESEND_FROM=onboarding@resend.dev

# Clave pública de Google Maps, restringida al dominio de la web.
GOOGLE_MAPS_API_KEY=
